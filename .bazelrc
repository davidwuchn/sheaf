common --enable_platform_specific_config
common --incompatible_autoload_externally=+@rules_cc,+@rules_python,+@rules_shell,+@rules_java
common --incompatible_disallow_empty_glob=false
common:linux --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
common:linux --repo_env=BAZEL_NO_APPLE_CPP_TOOLCHAIN=1
common:linux --@llvm//config:experimental_stub_libgcc_s=true

build --features=-layering_check
build --macos_minimum_os=13.0
build:linux --@iree//runtime/src/iree/hal/drivers:enabled_drivers=local-sync,local-task,cuda,vulkan
build:macos --@iree//runtime/src/iree/hal/drivers:enabled_drivers=local-sync,local-task,metal

build:debug --compilation_mode=dbg
build:debug --output_groups=+dsym_folder

build:release --compilation_mode=opt

build:cpu --@iree//runtime/src/iree/hal/drivers:enabled_drivers=local-sync,local-task
build:linux-gpu --@iree//runtime/src/iree/hal/drivers:enabled_drivers=local-sync,local-task,cuda,vulkan

build:linux-aarch64 --platforms=//bazel/platforms:linux_aarch64
build:linux-x86_64 --platforms=//bazel/platforms:linux_x86_64
build:macos-aarch64 --platforms=//bazel/platforms:macos_aarch64
