;; -*- mode: clojure -*-

(defn forward [x p]
  (as-> x h
    (with-params [p :l1] (relu (+ (@ h W) b)))
    (with-params [p :l2] (sigmoid (+ (@ h W) b)))))

(defn train-step [p x y lr]
  (let [loss-fn (fn [p] (mean (** (- (forward x p) y) 2)))
        [l g] ((value-and-grad loss-fn) p)]
    {:p (sgd-step p g lr) :loss l}))
