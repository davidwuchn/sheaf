;; -*- mode: clojure -*-
;;
;; The "Hello World" of Sheaf: XOR with a 2-layer MLP.

(use nn)
(use optim)


(defn init-params [key]
  (let [[k1 k2] (random-split key 2)]
    {:l1 {:W (random-normal k1 '[2 8])
          :b (zeros '[8])}
     :l2 {:W (random-normal k2 '[8 1])
          :b (zeros '[1])}}))


(defn forward [x p]
  (as-> x h
    (with-params [p :l1] (relu (+ (@ h W) b)))
    (with-params [p :l2] (sigmoid (+ (@ h W) b)))))


(defn loss [p x y]
  (mean (** (- (forward x p) y) 2)))


(defn train-step [p x y lr]
  (let [[l g] ((value-and-grad (fn [p] (loss p x y))) p)]
    {:p (sgd-step p g lr) :loss l}))


;; Batch n steps of SGD training
(defn train [p x y lr n]
  (reduce (fn [s _] (train-step (get s :p) x y lr))
          {:p p :loss 0.0}
          (range n)))
