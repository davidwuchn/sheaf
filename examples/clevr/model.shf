;; CLEVR Neuro-Symbolic Reasoning Model
;;
;; Differentiable visual reasoning: symbolic queries -> JAX computation.
;; Scene tensor: [Batch, N_objects, 9] = [color(4), shape(3), x, y]

(use nn)
(use optim)
(use ./utils.shf)


;; Pre-computed optimal parameters

(defn init-clevr-params [key]
  ; Initialize with optimized embeddings and temperatures
  {:color_embeddings [[1 0 0 0 0 0 0 0 0]    ;; red
                      [0 1 0 0 0 0 0 0 0]    ;; green
                      [0 0 1 0 0 0 0 0 0]    ;; blue
                      [0 0 0 1 0 0 0 0 0]]   ;; yellow
   :shape_embeddings [[0 0 0 0 1 0 0 0 0]    ;; circle
                      [0 0 0 0 0 1 0 0 0]    ;; square
                      [0 0 0 0 0 0 1 0 0]]   ;; triangle
   :temps {:filter 0.05 :unique 0.1 :leftmost 0.1 :spatial 0.05}
   :thresholds {:spatial 0.0 :exists 1.72}})


;; Vocabulary mapping

(defn attr-idx [name]
  (case name
    "red" 0 "green" 1 "blue" 2 "yellow" 3
    "circle" 0 "square" 1 "triangle" 2
    0))


;; Filters - wrap utils with learned embeddings

(defn filter-color [scene color-kw params]
  (let [idx (attr-idx (slice (str color-kw) 1))
        query (get (get params :color_embeddings) idx)]
    (soft-filter scene query (get-in params [:temps :filter]))))

(defn filter-shape [scene shape-kw params]
  (let [idx (attr-idx (slice (str shape-kw) 1))
        query (get (get params :shape_embeddings) idx)]
    (soft-filter scene query (get-in params [:temps :filter]))))


;; Selection

(defn unique [scene params]
  (soft-unique scene (get-in params [:temps :unique])))

(defn leftmost [scene params]
  (soft-leftmost scene (get-in params [:temps :leftmost])))

(defn rightmost [scene params]
  (soft-rightmost scene (get-in params [:temps :leftmost])))


;; Spatial relations - thin wrappers over utils.shf

(defn spatial-op [op scene ref params]
  (op scene ref
      (get-in params [:thresholds :spatial])
      (get-in params [:temps :spatial])))

(defn left-of [scene ref params]  (spatial-op spatial-left-of scene ref params))
(defn right-of [scene ref params] (spatial-op spatial-right-of scene ref params))
(defn above [scene ref params]    (spatial-op spatial-above scene ref params))
(defn below [scene ref params]    (spatial-op spatial-below scene ref params))


;; Logic & attribute queries

(defn exists? [scene params]
  (exists-any scene (get-in params [:thresholds :exists])))

(defn intersect [scene1 scene2]
  (intersect-scenes scene1 scene2))

(defn query-color [obj]    (query-attribute obj 0 4))
(defn query-shape [obj]    (query-attribute obj 4 7))
(defn query-position [obj] (query-attribute obj 7 9))



;; Query executor - the core of neuro-symbolic reasoning

(defn execute-query [scene q params]
 ; Execute a symbolic S-expression query on a scene
  (let [op (first q)
        arg1 (second q)
        rec (fn [subq] (execute-query scene subq params))]
    (case op
      "filter-color" (filter-color scene arg1 params)
      "filter-shape" (filter-shape scene arg1 params)
      "unique"       (unique (rec arg1) params)
      "leftmost"     (leftmost (rec arg1) params)
      "rightmost"    (rightmost (rec arg1) params)
      "left-of"      (left-of scene (rec arg1) params)
      "right-of"     (right-of scene (rec arg1) params)
      "above"        (above scene (rec arg1) params)
      "below"        (below scene (rec arg1) params)
      "exists?"      (exists? (rec arg1) params)
      "intersect"    (intersect (rec arg1) (rec (nth q 2)))
      "query-color"    (query-color (rec arg1))
      "query-shape"    (query-shape (rec arg1))
      "query-position" (query-position (rec arg1))
      scene)))

;; Execute query and track intermediate attention steps
;; Returns [result, [att1, att2, ...]] where atts are pure JAX tensors

;; Helper to extract attention weights from a scene tensor
(defn scene-to-attention [scene]
  (sum (abs scene) :axis -1))

(defn execute-query-with-steps [scene q params]
  "Execute query and return result with list of attention tensors"
  (let [op (first q)
        arg1 (second q)]

    (case op
      "filter-color"
      (let [result (filter-color scene arg1 params)
            att (scene-to-attention result)]
        [result [att]])

      "filter-shape"
      (let [result (filter-shape scene arg1 params)
            att (scene-to-attention result)]
        [result [att]])

      "unique"
      (let [sub-result (execute-query-with-steps scene arg1 params)
            sub-scene (get sub-result 0)
            sub-atts (get sub-result 1)
            result (unique sub-scene params)
            att (scene-to-attention result)]
        [result (concat sub-atts [att])])

      "leftmost"
      (let [sub-result (execute-query-with-steps scene arg1 params)
            sub-scene (get sub-result 0)
            sub-atts (get sub-result 1)
            result (leftmost sub-scene params)
            att (scene-to-attention sub-scene)]
        [result (concat sub-atts [att])])

      "rightmost"
      (let [sub-result (execute-query-with-steps scene arg1 params)
            sub-scene (get sub-result 0)
            sub-atts (get sub-result 1)
            result (rightmost sub-scene params)
            att (scene-to-attention sub-scene)]
        [result (concat sub-atts [att])])

      "left-of"
      (let [sub-result (execute-query-with-steps scene arg1 params)
            sub-scene (get sub-result 0)
            sub-atts (get sub-result 1)
            result (left-of scene sub-scene params)
            att (scene-to-attention result)]
        [result (concat sub-atts [att])])

      "query-color"
      (let [sub-result (execute-query-with-steps scene arg1 params)
            sub-scene (get sub-result 0)
            sub-atts (get sub-result 1)
            result (query-color sub-scene)]
        [result (concat sub-atts [result])])

      "query-shape"
      (let [sub-result (execute-query-with-steps scene arg1 params)
            sub-scene (get sub-result 0)
            sub-atts (get sub-result 1)
            result (query-shape sub-scene)]
        [result (concat sub-atts [result])])

      "exists?"
      (let [sub-result (execute-query-with-steps scene arg1 params)
            sub-scene (get sub-result 0)
            sub-atts (get sub-result 1)
            result (exists? sub-scene params)]
        [result (concat sub-atts [(scene-to-attention sub-scene)])])

      "intersect"
      (let [r1 (execute-query-with-steps scene arg1 params)
            s1 (get r1 0)
            atts1 (get r1 1)
            r2 (execute-query-with-steps scene (nth q 2) params)
            s2 (get r2 0)
            atts2 (get r2 1)
            result (intersect s1 s2)
            att (scene-to-attention result)]
        [result (concat atts1 atts2 [att])])

      ; Default: just execute query
      [(execute-query scene q params) []])))
