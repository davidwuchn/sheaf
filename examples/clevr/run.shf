;; -*- mode: clojure -*-

(use model)
(use data)

;; --- Helpers ---

;; Decode model output into predicted label + success flag.
(defn score-prediction [prediction query answer]
  (let [op (first query)]
    (case op
      "query-color" (let [pred (nth (colors) (argmax (get prediction 0)))]
                      {:predicted pred :success (== pred answer)})
      "query-shape" (let [pred (nth (shapes) (argmax (get prediction 0)))]
                      {:predicted pred :success (== pred answer)})
      (let [pred (> (float (get prediction 0)) 0.5)]
        {:predicted pred :success (== pred answer)}))))


;; Extract op names from a query tree in depth-first order (leaves first).
;; Matches the order that execute-query-with-steps returns attention tensors.
(defn is-subquery [arg]
  (!= (slice (str arg) 0 1) ":"))

(defn extract-op-names [query]
  (let [op   (first query)
        subs (reduce (fn [acc arg]
                       (if (is-subquery arg)
                         (concat acc (extract-op-names arg))
                         acc))
                     '[]
                     (rest query))]
    (concat subs (cons op '[]))))


;; Format attention weights as "label: val, ..." string.
(defn format-attention [attention objects]
  (concat
    (reduce (fn [acc j]
              (let [obj   (nth objects j)
                    label (concat (get obj :color) "_" (get obj :shape))]
                (concat acc
                        (if (> j 0) ", " "")
                        label ": "
                        (str-call "format" "{:.2f}" (float (get attention j))))))
            "["
            (range (count objects)))
    "]"))


;; Format logits as softmax probabilities (percentages).
(defn format-logits [logits attr-names]
  (let [probs (softmax logits :axis -1)]
    (concat
      (reduce (fn [acc j]
                (concat acc
                        (if (> j 0) ", " "")
                        (nth attr-names j) ": "
                        (str-call "format" "{:.0f}%" (* 100.0 (float (get probs j))))))
              "["
              (range (len probs)))
      "]")))


;; --- Main ---

;; Load parameters
(let [params (if (io "exists" "params.pkl")
                (io "load" "params.pkl")
                ;; No trained params: use random embeddings (demo will fail).
                (let [[ck sk] (random-split (random-key 0))]
                  {:color_embeddings (* (random-normal ck '[8 13]) 0.3)
                   :shape_embeddings (* (random-normal sk '[3 13]) 0.3)
                   :temps {:filter 0.1 :unique 0.1 :leftmost 0.1 :spatial 0.05}
                   :thresholds {:spatial 0.0 :exists 1.72}}))

      ;; Demo scene: retry until we get at least one square (needed for the detailed query)
      demo-seed (io "entropy")
      demo
        (while (== (get state :found) false)
          [state {:key (random-key demo-seed) :scene nil :found false}]
          (let [scene (generate-scene (get state :key) 5)
                has-square (> (count (filter (fn [o] (== (get o :shape) "square"))
                                            (get scene :objects)))
                              0)
                [k1 k2] (random-split (get state :key))]
            {:key k2 :scene scene :found has-square}))
      demo-scene   (get demo :scene)
      demo-tensor  (scene-to-tensor demo-scene)
      demo-batch   (reshape demo-tensor '[1 5 13])]

  ;; --- Display scene ---
  (do
    (print "CLEVR Neuro-Symbolic Reasoning\n")
    (print "Input tensor:")
    (print demo-tensor)
    (print "Shape: [5, 13]")
    (print "\nDecoded input:")
    (map (fn [o]
           (print "- {:7} {:8}    x={:.2f}    y={:.2f}"
                 (get o :color) (get o :shape) (get o :x) (get o :y)))
         (get demo-scene :objects))
    (print ""))

  ;; Build a test suite covering all query patterns with values from the scene.
  (let [objects (get demo-scene :objects)
        obj0 (nth objects 0)
        obj1 (nth objects 1)
        obj2 (nth objects 2)

        ;; Find an absent color for negative exists test
        present-colors (map (fn [o] (get o :color)) objects)
        absent-color (first (filter (fn [c] (not (find (fn [pc] (== pc c)) present-colors))) (colors)))

        ;; Find a valid spatial ref: unique color + exactly one object to its left
        spatial-colors
          (filter (fn [c]
                    (let [matches (filter (fn [o] (== (get o :color) c)) objects)]
                      (if (!= (count matches) 1) false
                        (let [ref (first matches)
                              left (filter (fn [o] (< (get o :x) (- (get ref :x) 0.1))) objects)]
                          (== (count left) 1)))))
                  (colors))

        queries
          [;; 1. exists? filter-color (present)
           {:query ["exists?" ["filter-color" (concat ":" (get obj0 :color))]]
            :answer true}
           ;; 2. exists? filter-color (absent)
           {:query ["exists?" ["filter-color" (concat ":" absent-color)]]
            :answer false}
           ;; 3. query-color leftmost filter-shape
           {:query ["query-color" ["leftmost" ["filter-shape" (concat ":" (get obj0 :shape))]]]
            :answer (get (reduce (fn [best o] (if (and (== (get o :shape) (get obj0 :shape))
                                                       (< (get o :x) (get best :x))) o best))
                                 obj0
                                 (filter (fn [o] (== (get o :shape) (get obj0 :shape))) objects))
                         :color)}
           ;; 4. query-color rightmost filter-shape
           {:query ["query-color" ["rightmost" ["filter-shape" (concat ":" (get obj1 :shape))]]]
            :answer (get (reduce (fn [best o] (if (and (== (get o :shape) (get obj1 :shape))
                                                       (> (get o :x) (get best :x))) o best))
                                 obj1
                                 (filter (fn [o] (== (get o :shape) (get obj1 :shape))) objects))
                         :color)}
           ;; 5. exists? intersect filter-color filter-shape (positive)
           {:query ["exists?" ["intersect" ["filter-color" (concat ":" (get obj0 :color))]
                                           ["filter-shape" (concat ":" (get obj0 :shape))]]]
            :answer true}
           ;; 6. exists? intersect filter-color filter-shape (negative)
           {:query ["exists?" ["intersect" ["filter-color" (concat ":" absent-color)]
                                           ["filter-shape" (concat ":" (get obj0 :shape))]]]
            :answer false}
           ;; 7. query-shape leftmost filter-color
           {:query ["query-shape" ["leftmost" ["filter-color" (concat ":" (get obj2 :color))]]]
            :answer (get (reduce (fn [best o] (if (and (== (get o :color) (get obj2 :color))
                                                       (< (get o :x) (get best :x))) o best))
                                 obj2
                                 (filter (fn [o] (== (get o :color) (get obj2 :color))) objects))
                         :shape)}]]

    (print "Running queries on this scene:")
    (print "----------------------------------------------------------")
    (let [result
            (reduce (fn [acc query-result]
                      (let [query      (get query-result :query)
                            answer     (get query-result :answer)
                            prediction (execute-query demo-batch query params)
                            scored     (score-prediction prediction query answer)
                            status     (if (get scored :success) "PASS" "FAIL")]
                        (do
                          (print "[{}] {} -> {} (expected: {})"
                                status query (get scored :predicted) answer)
                          {:passed (+ (get acc :passed) (if (get scored :success) 1 0))
                           :total  (+ (get acc :total) 1)})))
                    {:passed 0 :total 0}
                    queries)

          ;; 8. spatial left-of (if valid scene exists)
          result (if (> (count spatial-colors) 0)
                   (let [ref-color      (first spatial-colors)
                         ref            (first (filter (fn [o] (== (get o :color) ref-color)) objects))
                         target         (first (filter (fn [o] (< (get o :x) (- (get ref :x) 0.1))) objects))
                         query          ["query-shape" ["unique" ["left-of" ["unique" ["filter-color" (concat ":" ref-color)]]]]]
                         prediction     (execute-query demo-batch query params)
                         predicted-shape (nth (shapes) (argmax (get prediction 0)))
                         correct?       (== predicted-shape (get target :shape))]
                     (do
                       (print "[{}] {} -> {} (expected: {})"
                             (if correct? "PASS" "FAIL") query predicted-shape (get target :shape))
                       {:passed (+ (get result :passed) (if correct? 1 0))
                        :total  (+ (get result :total) 1)}))
                   result)

          passed (get result :passed)
          total  (get result :total)]

      (print "\nAccuracy: {}/{} ({:.1f}%)" passed total (* (/ (float passed) (float total)) 100.0)))

    ;; --- Detailed pipeline for "color of rightmost square" ---
    (let [custom-query ["query-color" ["rightmost" ["filter-shape" ":square"]]]
          query-result (execute-query-with-steps demo-batch custom-query params)
          steps        (get query-result :steps)
          predicted    (nth (colors) (argmax (get (get query-result :result) 0)))
          op-names     (extract-op-names custom-query)
          n-steps      (len steps)]

      (do
        (print "\n----------------------------------------------------------")
        (print "Detailed operations for query 'color of rightmost square'\n")
        (print "Symbolic attention shaping:\n")
        (print "Query: {}" custom-query)
        (print "Input: Scene [batch=1, n_objects=5, features=9]")
        (print "    |")

        (map (fn [i]
               (let [op-name     (nth op-names i)
                     step-values (let [raw (get steps i)]
                                   (if (== (ndim raw) 2) (get raw 0) raw))
                     is-last     (== i (- n-steps 1))]
                 (do
                   (print "[{}] {}" op-name op-name)
                   (if is-last
                     (let [attr-names (if (== op-name "query-color") (colors) (shapes))]
                       (print "  Probabilities: {}" (format-logits step-values attr-names)))
                     (print "  Attention: {}" (format-attention step-values (get demo-scene :objects))))
                   (print "    |"))))
             (range n-steps))

        (print "[Decision] argmax(logits): {}\n" (str-call "upper" predicted))))))
