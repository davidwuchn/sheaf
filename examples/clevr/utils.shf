;; CLEVR Utility Functions: Soft Differentiable Operations
;;
;; Key insight: SIGMOID for filters (independent probabilities),
;; SOFTMAX for selection (mutual exclusion).

;; Soft filtering - uses sigmoid for independent object selection
;; Filters objects by similarity to query vector.

(defn soft-filter [scene query-vec temperature]
  (let [scores (einsum "...nd,d->...n" scene query-vec)
        ;; Bias of -0.5 so score=0 -> attention~0, score=1 -> attention~1
        attention (sigmoid (/ (- scores 0.5) temperature))]
    (* scene (reshape attention '[-1 1]))))


;; Soft selection - uses softmax for mutual exclusion

;; Select single object via softmax over presence scores.
(defn soft-unique [scene temperature]
  (let [objectness (sum (abs scene) :axis -1)
        attention (softmax (/ objectness temperature) :axis -1)]
    (einsum "...n,...nd->...d" attention scene)))

;; Select leftmost object (smallest x) via softmax.
(defn soft-leftmost [scene temperature]
  (let [x-coords (get scene ... 7)
        objectness (sum (abs scene) :axis -1)
        is-present (> objectness 1e-3)
        scores (/ (* x-coords -1.0) temperature)
        masked-scores (where is-present scores -1e10)
        attention (softmax masked-scores :axis -1)]
    (einsum "...n,...nd->...d" attention scene)))

;; Select rightmost object (largest x) via softmax.
(defn soft-rightmost [scene temperature]
  (let [x-coords (get scene ... 7)
        objectness (sum (abs scene) :axis -1)
        is-present (> objectness 1e-3)
        scores (/ x-coords temperature)
        masked-scores (where is-present scores -1e10)
        attention (softmax masked-scores :axis -1)]
    (einsum "...n,...nd->...d" attention scene)))


;; Spatial relations - macro-generated

(defmacro defspatial [name axis sign]
  `(defn ~name [scene ref threshold temp]
     (let [scene-coord (get scene ... ~axis)
           ref-coord (get ref ... ~axis)
           ref-ndim (ndim ref-coord)
           ref-expanded (if (== ref-ndim 1)
                          (reshape ref-coord '[-1 1 1])
                          (reshape ref-coord `[-1 ~(shape ref-coord 1) 1]))
           scene-expanded (reshape scene-coord `[-1 ~(shape scene-coord 1) 1])
           relative (- scene-expanded ref-expanded)
           score-input (if (== ~sign -1)
                          (* -1.0 (+ relative threshold))
                          (- relative threshold))
           scores (sigmoid (/ score-input temp))]
       (* scene scores))))

(defspatial spatial-left-of 7 -1)
(defspatial spatial-right-of 7 1)
(defspatial spatial-above 8 1)
(defspatial spatial-below 8 -1)


;; Logic operations

;; Check if any object exists (returns probability).
(defn exists-any [scene threshold]
  (let [objectness (sum (abs scene) :axis -1)
        total-presence (sum objectness :axis -1)]
    (sigmoid (* 5.0 (- total-presence threshold)))))

;; Intersection of two filtered scenes.
(defn intersect-scenes [scene1 scene2]
  (minimum scene1 scene2))


;; Attribute extraction

;; Extract attribute slice as logits (not normalized).
(defn query-attribute [obj start end]
  (let [aggregated (if (== (ndim obj) 3) (sum obj :axis -2) obj)
        attribute (get aggregated ... (range start end))]
    attribute))
