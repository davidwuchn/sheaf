load(":test_rules.bzl", "sheaf_integration_test", "sheaf_program_test")
load("@rules_rust//rust:defs.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

rust_test(
    name = "unit",
    crate = "//sheaf:compiler_lib",
    data = ["@iree_compiler//:iree-compile"],
    env = {
        "IREE_COMPILE": "$(rootpath @iree_compiler//:iree-compile)",
        "RUST_TEST_THREADS": "1",
    },
    rustc_flags = [
        "--cfg=iree_runtime",
        "--check-cfg=cfg(cargo_source_prelude)",
        "--check-cfg=cfg(iree_runtime)",
        "--check-cfg=cfg(sheaf_frontend)",
        "--check-cfg=cfg(test)",
    ],
)

sheaf_integration_test(name = "compiler_tests")
sheaf_integration_test(
    name = "interpreter_tests",
    data = [
        "interpreter_tests.yaml",
        "macro_tests.yaml",
        "vag_tests.yaml",
    ],
)
sheaf_integration_test(name = "mem_attribution")
sheaf_integration_test(name = "parser_tests")
sheaf_integration_test(name = "polymorphic_jit_reuse")
sheaf_integration_test(name = "shared_session")

sheaf_program_test(
    name = "regression_mlp",
    expression = """
(use \"./examples/mlp/training.shf\")
(use \"./sheaf/tests/regressions.shf\")
(check-mlp)
""",
    data = [
        "//:examples/mlp/mlp.shf",
        "//:examples/mlp/training.shf",
    ],
    size = "small",
)

sheaf_program_test(
    name = "regression_hydra",
    expression = """
(use \"./examples/hydra/hydra.shf\")
(use \"./sheaf/tests/regressions.shf\")
(check-hydra)
""",
    data = ["//:examples/hydra/hydra.shf"],
    size = "small",
)

sheaf_program_test(
    name = "regression_clevr",
    expression = """
(use \"./examples/clevr/data.shf\")
(use \"./examples/clevr/model.shf\")
(use \"./sheaf/tests/regressions.shf\")
(check-clevr)
""",
    data = [
        "//:examples/clevr/data.shf",
        "//:examples/clevr/model.shf",
        "//:examples/clevr/utils.shf",
    ],
    size = "small",
)

sheaf_program_test(
    name = "regression_clevr_training",
    expression = """
(use "./examples/clevr/data.shf")
(use "./examples/clevr/model.shf")
(use "./sheaf/tests/regressions.shf")
(check-clevr-training)
""",
    data = [
        "//:examples/clevr/data.shf",
        "//:examples/clevr/model.shf",
        "//:examples/clevr/utils.shf",
    ],
    size = "small",
)

sheaf_program_test(
    name = "regression_nanogpt",
    expression = """
(use \"./examples/nanogpt/train.shf\")
(use \"./sheaf/tests/regressions.shf\")
(check-nanogpt)
""",
    data = [
        "//examples/nanogpt:model.shf",
        "//examples/nanogpt:train.shf",
    ],
    size = "large",
    timeout = "long",
)

sheaf_program_test(
    name = "regression_macros",
    expression = """
(use \"./sheaf/tests/regressions.shf\")
(check-macros)
""",
    size = "small",
)

sheaf_program_test(
    name = "regression_runtime_dtypes",
    expression = """
(defn sixteen-bit-roundtrip [x] (reshape x (quote [1])))
(let [f16 (sixteen-bit-roundtrip (cast (tensor [1.0006]) :f16))
      bf16 (sixteen-bit-roundtrip (cast (tensor [1.005]) :bf16))]
  (do
    (guard :range [1.0009 1.0011] f16)
    (guard :range [1.007 1.009] bf16)
    true))
""",
    size = "small",
)

test_suite(
    name = "all",
    tests = [
        ":compiler_tests",
        ":regression_clevr",
        ":regression_clevr_training",
        ":regression_hydra",
        ":regression_macros",
        ":regression_mlp",
        ":regression_nanogpt",
        ":regression_runtime_dtypes",
        ":interpreter_tests",
        ":mem_attribution",
        ":parser_tests",
        ":polymorphic_jit_reuse",
        ":shared_session",
        ":unit",
    ],
)
