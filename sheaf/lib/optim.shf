(defn sgd-step [params grads lr]
  (tree-map (fn [p g] (- p (* lr g))) params grads))


(defn adam-step [params grads m v t lr b1 b2 eps]
  ;; Returns [new-params new-m new-v new-t].
  (let [new-t (+ t 1)
        new-m (tree-map (fn [md gd] (+ (* b1 md) (* (- 1 b1) gd))) m grads)
        new-v (tree-map (fn [vd gd] (+ (* b2 vd) (* (- 1 b2) (* gd gd)))) v grads)
        bias-correction-m (/ 1.0 (- 1 (** b1 new-t)))
        bias-correction-v (/ 1.0 (- 1 (** b2 new-t)))
        new-p (tree-map (fn [p mh vh]
                          (- p (/ (* lr mh bias-correction-m)
                                  (+ (sqrt (* vh bias-correction-v)) eps))))
                        params new-m new-v)]
    [new-p new-m new-v new-t]))


(defn adamw-step [params grads m v t lr b1 b2 eps wd]
  ;; AdamW applies weight decay separately from the gradient update.
  ;; Returns [new-params new-m new-v new-t].
  (let [new-t (+ t 1)
        new-m (tree-map (fn [md gd] (+ (* b1 md) (* (- 1 b1) gd))) m grads)
        new-v (tree-map (fn [vd gd] (+ (* b2 vd) (* (- 1 b2) (* gd gd)))) v grads)
        bias-correction-m (/ 1.0 (- 1 (** b1 new-t)))
        bias-correction-v (/ 1.0 (- 1 (** b2 new-t)))
        new-p (tree-map (fn [p mh vh]
                          (- p (* lr (+ (* wd p)
                                       (/ (* mh bias-correction-m)
                                          (+ (sqrt (* vh bias-correction-v)) eps))))))
                        params new-m new-v)]
    [new-p new-m new-v new-t]))


(defn sgd-momentum-step [params grads buf momentum lr]
  ;; Initialize buf with (tree-map-zeros params). Returns [new-params new-buf].
  (let [new-buf (tree-map (fn [b g] (+ (* momentum b) g)) buf grads)
        new-p (tree-map (fn [p b] (- p (* lr b))) params new-buf)]
    [new-p new-buf]))


(defn global-norm [pytree]
  (sqrt (tree-reduce +
                     (tree-map (fn [g] (__cast-like (sum (** g 2)) 0.0)) pytree)
                     0.0)))


(defn clip-by-global-norm [pytree max-norm]
  (let [g-norm (global-norm pytree)
        clip-factor (minimum 1.0 (/ max-norm (+ g-norm 1e-8)))]
    (tree-map (fn [g] (* g (__cast-like clip-factor g))) pytree)))


;; Learning-rate schedules

(defn linear-warmup [lr step warmup-steps]
  (let [ratio (/ step warmup-steps)]
    (* lr (minimum 1.0 ratio))))

(defn inverse-sqrt-warmup [lr step warmup-steps]
  ;; Linear warmup followed by inverse-square-root decay.
  (let [s (float step)
        w (float warmup-steps)]
    (* lr
       (** w -0.5)
       (minimum (** s -0.5) (* s (** w -1.5))))))

(defn exponential-decay [lr step decay-steps decay-rate]
  (* lr (** decay-rate (/ step decay-steps))))

(defn step-decay [lr step step-size decay-rate]
  (* lr (** decay-rate (// step step-size))))

(defn cosine-decay [lr step warmup-steps total-steps]
  ;; Linear warmup followed by cosine decay to zero at total-steps.
  (let [s        (float step)
        warmup   (float warmup-steps)
        total    (float total-steps)
        pi       3.1415927
        progress (minimum 1.0 (/ (- s warmup) (- total warmup)))
        warmup-lr (* lr (/ s warmup))
        decay-lr  (* lr (* 0.5 (+ 1.0 (cos (* pi progress)))))]
    (where (< s warmup) warmup-lr decay-lr)))
