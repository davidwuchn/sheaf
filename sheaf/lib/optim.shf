;; Optimizer library for Sheaf

(defn sgd-step (params grads lr)
  ;; Stochastic gradient descent: p := p - lr * g
  (tree-map (lambda (p g) (- p (* lr g))) params grads))


(defn adam-step (params grads state lr b1=0.9 b2=0.999 eps=1e-8)
  ;; Adam optimizer step with bias correction

  ;; Args:
  ;;   params: Parameter tree
  ;;   grads: Gradient tree (same structure as params)
  ;;   state: Dict with :m, :v, :t (or empty dict)
  ;;   lr: Learning rate
  ;;   b1: First moment decay (default 0.9)
  ;;   b2: Second moment decay (default 0.999)
  ;;   eps: Numerical stability constant (default 1e-8)

  (let (m (get state :m (tree-map-zeros params))
        v (get state :v (tree-map-zeros params))
        t (+ 1 (get state :t 0))
        nm (tree-map (lambda (md gd) (+ (* b1 md) (* (- 1 b1) gd))) m grads)
        nv (tree-map (lambda (vd gd) (+ (* b2 vd) (* (- 1 b2) (** gd 2)))) v grads)
        bias-correction-m (/ 1.0 (- 1 (** b1 t)))
        bias-correction-v (/ 1.0 (- 1 (** b2 t))))
    (dict :p (tree-map (lambda (p mh vh)
                         (- p (/ (* lr mh bias-correction-m)
                                 (+ (sqrt (* vh bias-correction-v)) eps))))
                       params nm nv)
          ;; Return
          :m nm
          :v nv
          :t t)))


(defn global-norm (pytree)
  ;; Compute global L2 norm of all leaves in a pytree
  (sqrt (sum (tree-map (lambda (g) (sum (** g 2))) pytree))))


(defn clip-by-global-norm (pytree max-norm)
  ;; Clip gradients by global L2 norm
  ;; If norm exceeds max-norm, scale all gradients proportionally
  (let (g-norm (global-norm pytree)
        clip-factor (minimum 1.0 (/ max-norm (+ g-norm 1e-8))))
    (tree-map (lambda (g) (* g clip-factor)) pytree)))
