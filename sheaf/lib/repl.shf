; REPL utilities - formatting and validation logic
; Portable from Python REPL to Sheaf
; Part of the Sheaf Language

; Check if parentheses and brackets are balanced in text
; Returns True if balanced, False otherwise
; State encoding: 0 = valid/balanced, -1 = error/invalid, N = depth N
(defn is-balanced? [text]
  (let (process-char (lambda [state i]
          (let (depth state
                char (slice text i (+ i 1)))

            (if (< depth 0)
              state  ; Already invalid, propagate error

              (case char
                "(" (+ depth 1)
                "[" (+ depth 1)
                "{" (+ depth 1)
                ")" (if (> depth 0) (- depth 1) -1)
                "]" (if (> depth 0) (- depth 1) -1)
                "}" (if (> depth 0) (- depth 1) -1)
                depth))))  ; default: no-op

        len-text (len text)
        indices (range len-text)
        result (scan process-char 0 indices)
        final-state (get result 0))

    ; Valid if: depth is 0 and not error
    (and (= final-state 0)
         (>= final-state 0))))


; Format a tensor for REPL display
(defn format-tensor [t]
  (concat "Tensor"))


; Format a dictionary for REPL display
(defn format-dict [d]
  (concat "Dict with " (str (count d)) " keys"))


; Format a result value for REPL display
; Returns a formatted string (or empty string for nil)
(defn format-result [value]
  (if (nil? value)
    ""
    (str value)))
