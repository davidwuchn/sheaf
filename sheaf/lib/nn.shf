;; Neural network library for Sheaf


;; Activation functions
;; Defined in Sheaf so the JIT inlines them into the caller's MLIR,
;; enabling kernel fusion (e.g. matmul + relu = one IREE dispatch).

(defn relu [x] (maximum x 0.0))

(defn sigmoid [x] (/ 1.0 (+ 1.0 (exp (- 0 x)))))

(defn silu [x] (* x (sigmoid x)))

(defn gelu [x]
  (* 0.5 (* x (+ 1.0 (tanh (* 0.7978846 (+ x (* 0.044715 (* x (* x x))))))))))

(defn leaky-relu [x slope]
  (+ (maximum x 0.0) (* slope (minimum x 0.0))))

(defn selu [x]
  (let [alpha 1.6732632
        scale 1.0507010]
    (* scale (+ (maximum x 0.0) (* alpha (- (exp (minimum x 0.0)) 1.0))))))

(defn celu [x]
  (+ (maximum x 0.0) (minimum 0.0 (- (exp x) 1.0))))

(defn softmax [x]
  (let [e (exp (- x (max x :axis -1 :keepdims)))]
    (/ e (sum e :axis -1 :keepdims))))

(defn log-softmax [x]
  (let [s (- x (max x :axis -1 :keepdims))]
    (- s (log (sum (exp s) :axis -1 :keepdims)))))


;; Regularization

(defn dropout [x key p]
  ;; Inverted dropout. With probability p each element is zeroed; the rest are
  ;; scaled by 1/(1-p) so the expected value is preserved and no rescaling is
  ;; needed at inference (simply omit the call). Pass a freshly split PRNG key
  ;; on every call to keep draws independent across steps. Requires p in [0, 1).
  (let [mask (> (random-uniform key (shape x)) p)]
    (where mask (/ x (- 1.0 p)) 0.0)))


;; Loss functions

(defn cross-entropy-loss [logits targets]
  (let [V (int (last (shape logits)))
        log-p (log-softmax (reshape logits (cons -1 (cons V '[]))) :axis -1)
        flat-targets (reshape targets (cons -1 '[]))
        target-mask (one-hot flat-targets V)
        target-log-probs (sum (* log-p target-mask) :axis -1)]
    (* (mean target-log-probs) -1.0)))


(defn layer-norm [x p axis]
  (let [eps 1e-5
        ;; if no axis is specified, use -1
        m (mean x :axis axis :keepdims)
        v (var x :axis axis :keepdims)
        gamma (get p :gamma)
        beta (get p :beta)]
    (+ (* (/ (- x m) (sqrt (+ v eps))) gamma) beta)))


(defn rms-norm [x p axis]
  (let [eps 1e-6
        ;; RMS normalization: (x / RMS(x)) * gamma + beta
        ;; RMS = sqrt(mean(x^2) + eps)
        mean-sq (mean (* x x) :axis axis :keepdims)
        rms (sqrt (+ mean-sq eps))
        gamma (get p :gamma)
        beta (get p :beta)]
    (+ (* (/ x rms) gamma) beta)))


(defn linear [x w b]
  (+ (@ x w) b))


;; Weight initializers
;; All follow (init key shape) convention, matching PyTorch naming.

(defn xavier-uniform [key shape]
  ;; Xavier/Glorot uniform: U(-limit, limit), limit = sqrt(6 / (fan_in + fan_out))
  ;; Usage: (xavier-uniform (random-key 0) '[768 512])
  (let [fan-in  (first shape)
        fan-out (second shape)
        limit (sqrt (/ 6.0 (+ fan-in fan-out)))]
    (* (- (* (random-uniform key shape) 2.0) 1.0) limit)))

(defn xavier-normal [key shape]
  ;; Xavier/Glorot normal: N(0, sqrt(2 / (fan_in + fan_out)))
  ;; Usage: (xavier-normal (random-key 0) '[768 512])
  (let [fan-in  (first shape)
        fan-out (second shape)]
    (* (random-normal key shape) (sqrt (/ 2.0 (+ fan-in fan-out))))))

(defn kaiming-uniform [key shape]
  ;; Kaiming/He uniform: U(-limit, limit), limit = sqrt(6 / fan_in)
  ;; Usage: (kaiming-uniform (random-key 0) '[768 512])
  (let [fan-in (first shape)
        limit (sqrt (/ 6.0 fan-in))]
    (* (- (* (random-uniform key shape) 2.0) 1.0) limit)))

(defn kaiming-normal [key shape]
  ;; Kaiming/He normal: N(0, sqrt(2 / fan_in))
  ;; Usage: (kaiming-normal (random-key 0) '[768 512])
  (let [fan-in (first shape)]
    (* (random-normal key shape) (sqrt (/ 2.0 fan-in)))))

(defn lecun-normal [key shape]
  ;; LeCun normal: N(0, sqrt(1 / fan_in))
  ;; Usage: (lecun-normal (random-key 0) '[768 512])
  (let [fan-in (first shape)]
    (* (random-normal key shape) (sqrt (/ 1.0 fan-in)))))

(defn lecun-uniform [key shape]
  ;; LeCun uniform: U(-limit, limit), limit = sqrt(3 / fan_in)
  ;; Usage: (lecun-uniform (random-key 0) '[768 512])
  (let [fan-in (first shape)
        limit (sqrt (/ 3.0 fan-in))]
    (* (- (* (random-uniform key shape) 2.0) 1.0) limit)))

(defn clamp [x lo hi]
  (maximum (minimum x hi) lo))

(defn mse-loss [y-pred y-true]
  ;; MSE = mean((y-pred - y-true)^2)
  (let [diff (- y-pred y-true)]
    (mean (* diff diff))))

(defn mae-loss [y-pred y-true]
  ;; MAE = mean(abs(y-pred - y-true))
  (mean (abs (- y-pred y-true))))
